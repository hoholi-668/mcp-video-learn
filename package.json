{
  "name": "mcp-video-learn",
  "version": "0.4.0",
  "description": "MCP server that lets an LLM actually watch videos and animated stickers: metadata, frame grids, subtitles.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-video-learn": "src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/",
    "selftest": "node scripts/selftest-video.mjs",
    "selftest:matrix": "node scripts/selftest-matrix.mjs",
    "selftest:mcp": "node scripts/selftest-mcp.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "video",
    "bilibili",
    "gif",
    "animated-sticker",
    "ffmpeg",
    "yt-dlp",
    "llm"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "author": "HOHOLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoholi-668/mcp-video-learn.git"
  },
  "homepage": "https://github.com/hoholi-668/mcp-video-learn#readme",
  "bugs": {
    "url": "https://github.com/hoholi-668/mcp-video-learn/issues"
  }
}

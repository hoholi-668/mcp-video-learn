{
  "name": "mcp-video-learn",
  "version": "0.1.0",
  "description": "MCP server that lets an LLM actually watch a Bilibili video: metadata, a 3x3 frame grid, and subtitles when available.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-video-learn": "src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test test/"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bilibili",
    "video",
    "llm",
    "ffmpeg",
    "yt-dlp"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "author": "HOHOLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoholi-668/mcp-video-learn.git"
  },
  "homepage": "https://github.com/hoholi-668/mcp-video-learn#readme",
  "bugs": {
    "url": "https://github.com/hoholi-668/mcp-video-learn/issues"
  }
}
